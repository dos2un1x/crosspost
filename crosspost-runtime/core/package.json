{
  "name": "@crosspost/core",
  "version": "2.0.0",
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-3.0-only",
  "description": "CrossPost 核心逻辑 - 平台适配器、运行时抽象、同步引擎",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dos2un1x/crosspost.git"
  },
  "bugs": {
    "url": "https://github.com/dos2un1x/crosspost/issues"
  },
  "homepage": "https://github.com/dos2un1x/crosspost#readme",
  "author": "CrossPost",
  "keywords": [
    "crosspost",
    "markdown",
    "wechat",
    "weixin",
    "multi-platform",
    "publisher",
    "content",
    "article"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.mts",
      "import": "./dist/adapters/index.mjs",
      "require": "./dist/adapters/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.js"
    },
    "./md2we": {
      "types": "./dist/render/index.d.mts",
      "import": "./dist/render/index.mjs",
      "require": "./dist/render/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "tsup.config.ts"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepack": "cp ../../LICENSE ./LICENSE",
    "postpack": "rm -f ./LICENSE"
  },
  "dependencies": {
    "js-md5": "^0.8.3",
    "jsdom": "^24.1.3",
    "juice": "^11.1.0",
    "markdown-draft-js": "^2.4.0",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "marked": "^17.0.1",
    "mathjax-full": "^3.2.1",
    "playwright": "^1.62.1",
    "remarkable": "^2.0.1",
    "sharp": "^0.35.3",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.4.0",
    "@types/remarkable": "^2.0.8",
    "@vitest/coverage-v8": "^1.6.1",
    "tsup": "^8.0.1",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
